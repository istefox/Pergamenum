{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Pergamenum light theme. Parchment ground, ink text, ochre accent.",
  "meta": {
    "name": { "$type": "string", "$value": "Pergamenum Light" },
    "appearance": { "$type": "string", "$value": "light" }
  },
  "color": {
    "$type": "color",
    "background": {
      "primary": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#F7F5F1" },
      "tertiary": { "$value": "#EFEBE4" }
    },
    "surface": {
      "card": { "$value": "#FFFFFF" },
      "raised": { "$value": "#FFFFFF" },
      "sunken": { "$value": "#F2EFE9" },
      "received": { "$value": "#F1EFEA" },
      "sent": { "$value": "#E7EEF6" },
      "entry": { "$value": "#FBF2D9" }
    },
    "border": {
      "subtle": { "$value": "#E5E0D8" },
      "strong": { "$value": "#CFC8BC" }
    },
    "text": {
      "primary": { "$value": "#1C1B18" },
      "secondary": { "$value": "#6B665D" },
      "tertiary": { "$value": "#9C968B" },
      "inverted": { "$value": "#FFFFFF" }
    },
    "accent": {
      "primary": { "$value": "#9A5B1F" },
      "muted": { "$value": "#F3E7DA" },
      "onAccent": { "$value": "#FFFFFF" }
    },
    "canvas": {
      "background": { "$value": "#F2EFE9" },
      "grid": { "$value": "#E3DED4" },
      "selection": { "$value": "#9A5B1F" }
    },
    "task": {
      "open": { "$value": "#1C1B18" },
      "done": { "$value": "#9C968B" },
      "scheduled": { "$value": "#3B6EA5" },
      "overdue": { "$value": "#B3261E" },
      "cancelled": { "$value": "#9C968B" }
    },
    "calendar": {
      "prefestive": { "$value": "#C98B84" },
      "festive": { "$value": "#B3261E" },
      "holiday": { "$value": "#D62828" }
    },
    "code": {
      "keyword": { "$value": "#7E4B7A" },
      "string": { "$value": "#4B7A4F" },
      "comment": { "$value": "#9C968B" },
      "number": { "$value": "#2F6E6B" },
      "type": { "$value": "#3B6EA5" }
    },
    "sticky": {
      "yellow": { "$value": "#FBF0C4" },
      "green": { "$value": "#DFEBD4" },
      "blue": { "$value": "#D8E5F0" },
      "pink": { "$value": "#F6DEE0" },
      "grey": { "$value": "#E8E5DF" }
    },
    "category": {
      "yellow": { "$value": "#D99A00" },
      "green": { "$value": "#2E9E4F" },
      "blue": { "$value": "#1F6FEB" },
      "pink": { "$value": "#DB3F6F" },
      "grey": { "$value": "#6E7378" }
    }
  },
  "font": {
    "$type": "typography",
    "title": {
      "$value": { "fontFamily": "system", "fontSize": 22, "fontWeight": 600, "lineHeight": 1.2 }
    },
    "heading": {
      "$value": { "fontFamily": "system", "fontSize": 16, "fontWeight": 600, "lineHeight": 1.3 }
    },
    "body": {
      "$value": { "fontFamily": "system", "fontSize": 13, "fontWeight": 400, "lineHeight": 1.5 }
    },
    "caption": {
      "$value": { "fontFamily": "system", "fontSize": 11, "fontWeight": 400, "lineHeight": 1.35 }
    },
    "mono": {
      "$value": { "fontFamily": "monospace", "fontSize": 12, "fontWeight": 400, "lineHeight": 1.45 }
    },
    "prose": {
      "$value": { "fontFamily": "Avenir Next", "fontSize": 16, "fontWeight": 400, "lineHeight": 1.4 }
    },
    "proseTitle": {
      "$value": { "fontFamily": "Avenir Next", "fontSize": 24, "fontWeight": 700, "lineHeight": 1.2 }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "s": { "$value": { "value": 8, "unit": "px" } },
    "m": { "$value": { "value": 16, "unit": "px" } },
    "l": { "$value": { "value": 24, "unit": "px" } },
    "xl": { "$value": { "value": 40, "unit": "px" } },
    "readable": { "$value": { "value": 720, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "card": { "$value": { "value": 10, "unit": "px" } },
    "control": { "$value": { "value": 6, "unit": "px" } },
    "sticky": { "$value": { "value": 4, "unit": "px" } }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": { "color": "#1C1B1814", "offsetX": 0, "offsetY": 1, "blur": 3, "spread": 0 }
    },
    "raised": {
      "$value": { "color": "#1C1B181F", "offsetX": 0, "offsetY": 6, "blur": 18, "spread": 0 }
    }
  }
}
