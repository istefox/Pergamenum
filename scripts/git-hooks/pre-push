#!/usr/bin/env bash
#
# Blocks a push that would land a merge commit silently overriding a parent's
# content on the remote, before it ever reaches GitHub.
#
# ADR-0061, root cause of PG-240 (issue #522): a merge commit's message can
# claim it only resolved a TODO.md conflict while its tree quietly discards
# every other file an ancestor had already changed, because git raises no
# conflict on a path nothing else touched since. scripts/check-merge-integrity.py
# is the actual detector; this hook is only the local trigger for it, since
# this repository has no branch protection to make the CI job (which runs the
# same script) a real gate. Installed by scripts/install-git-hooks.sh.
#
# ADR-0062 (PG-242, issue #535) adds the landing check: a squash or a rebase
# leaves no merge commit to inspect, so for every pushed branch the hook also
# asks whether landing it on main would put a path back to a version main's
# own history already moved past (`--landing BASE HEAD`). BASE is the remote's
# old tip when pushing main itself, otherwise refs/remotes/<remote>/main, with
# <remote> read from $1 rather than hardcoded. A base that cannot be resolved
# locally, or a checkout whose checker predates --landing, prints a notice and
# skips the landing check instead of blocking — and, since PG-244, the merge
# scan of a brand-new remote ref does the same: never fail a push the hook
# cannot evaluate. The hook does not fetch; see ADR-0062 §D5 for why a stale
# remote-tracking ref costs no detection in the shape this check exists for.
#
# The checker's exit code is read, not just its truthiness (PG-251): 1 is a
# finding and gets the refusal that explains it; 2 is a check that could not
# be evaluated (a malformed Merge-override or Restore-override trailer, or a
# merge git cannot recompute). The push still stops on a 2, since it is almost
# always a trailer to fix, but under its own message, never the one claiming a
# parent's content was discarded.
#
# The installed hook is a copy: after this file changes, rerun
# scripts/install-git-hooks.sh --force (the checker warns until you do).

set -euo pipefail

remote_name="${1:-origin}"
toplevel="$(git rev-parse --show-toplevel)"
checker="$toplevel/scripts/check-merge-integrity.py"

if [ ! -f "$checker" ]; then
    # A checkout at a commit before this guard existed. Nothing to run.
    exit 0
fi

zero="0000000000000000000000000000000000000000"
merge_failed=0
landing_failed=0
merge_unevaluable=0
landing_unevaluable=0

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$zero" ]; then
        continue  # deleting a remote ref: nothing is being pushed
    fi
    if [ "$remote_sha" = "$zero" ]; then
        # A brand-new remote ref: scan against the remote's main rather than the
        # full history (ADR-0061 §D3). PG-244: that ref was hardcoded as
        # origin/main, and when it is absent git rev-list failed and blocked the
        # push; now it follows $1 and a missing one skips with a notice.
        range_base="refs/remotes/$remote_name/main"
        if git rev-parse --verify --quiet "$range_base^{commit}" >/dev/null; then
            range="$range_base..$local_sha"
        else
            range=""
            echo "pre-push: AVVISO — base $range_base non disponibile in locale, scan dei merge saltato per $remote_ref"
        fi
    else
        range="$remote_sha..$local_sha"
    fi
    if [ -n "$range" ]; then
        echo "pre-push: check-merge-integrity su $range ($remote_ref)"
        rc=0
        python3 "$checker" --range "$range" || rc=$?
        case "$rc" in
            0) ;;
            1) merge_failed=1 ;;
            *) merge_unevaluable=1 ;;
        esac
    fi

    # --- landing check (ADR-0062) ---
    case "$remote_ref" in
        refs/heads/*) ;;
        *)
            echo "pre-push: controllo di landing saltato per $remote_ref (non è un branch)"
            continue
            ;;
    esac
    if [ "$remote_ref" = "refs/heads/main" ] && [ "$remote_sha" != "$zero" ]; then
        base_rev="$remote_sha"
    else
        base_rev="refs/remotes/$remote_name/main"
    fi
    if ! base="$(git rev-parse --verify --quiet "$base_rev^{commit}")" \
        || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
        echo "pre-push: AVVISO — base $base_rev non disponibile in locale, controllo di landing saltato per $remote_ref"
        continue
    fi
    if ! grep -q -- '--landing' "$checker"; then
        echo "pre-push: AVVISO — $checker non conosce --landing (checkout precedente ad ADR-0062), controllo di landing saltato"
        continue
    fi
    echo "pre-push: controllo di landing di $local_sha su $base ($base_rev)"
    rc=0
    python3 "$checker" --landing "$base" "$local_sha" || rc=$?
    case "$rc" in
        0) ;;
        1) landing_failed=1 ;;
        *) landing_unevaluable=1 ;;
    esac
done

if [ "$merge_failed" -ne 0 ]; then
    {
        echo ""
        echo "pre-push RIFIUTATO (controllo dei merge, ADR-0061): un merge in questo push"
        echo "scarta in silenzio il contenuto di un genitore senza che un conflitto reale"
        echo "lo giustifichi (PG-240)."
        echo "Se è intenzionale, aggiungi al messaggio del merge commit:"
        echo "    Merge-override: <path>"
        echo "    Merge-override-reason: <motivo>"
        echo "poi 'git commit --amend' sul merge e riprova."
    } >&2
fi
if [ "$merge_unevaluable" -ne 0 ]; then
    {
        echo ""
        echo "pre-push RIFIUTATO (controllo dei merge, ADR-0061): un merge non è stato"
        echo "valutato, il controllo è uscito con 2. Di solito è un trailer Merge-override"
        echo "malformato (manca Merge-override-reason, oppure 'all' al posto dei path);"
        echo "più raramente un merge che git merge-tree non riesce a ricalcolare."
        echo "Il motivo esatto è stampato qui sopra."
    } >&2
fi
if [ "$landing_failed" -ne 0 ]; then
    {
        echo ""
        echo "pre-push RIFIUTATO (controllo di landing, ADR-0062): questo push riporterebbe"
        echo "su main una versione di un file che main aveva già superato (PG-242)."
        echo "Se è intenzionale, aggiungi a un commit qualunque del branch (non vale"
        echo "Merge-override, la chiave è un'altra):"
        echo "    Restore-override: <path>"
        echo "    Restore-override-reason: <motivo>"
        echo "Il blocco pronto da incollare, con ogni path, è stampato qui sopra."
    } >&2
fi
if [ "$landing_unevaluable" -ne 0 ]; then
    {
        echo ""
        echo "pre-push RIFIUTATO (controllo di landing, ADR-0062): il landing non è stato"
        echo "valutato, il controllo è uscito con 2. Di solito è un trailer Restore-override"
        echo "malformato (manca Restore-override-reason, oppure 'all' al posto dei path);"
        echo "più raramente un landing che git merge-tree non riesce a ricalcolare."
        echo "Il motivo esatto è stampato qui sopra."
    } >&2
fi
if [ "$merge_failed" -ne 0 ] || [ "$landing_failed" -ne 0 ] \
    || [ "$merge_unevaluable" -ne 0 ] || [ "$landing_unevaluable" -ne 0 ]; then
    exit 1
fi

exit 0
